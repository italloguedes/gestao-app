# .npmrc para Wacom Signature SDK
# Este arquivo configura o registro privado da Wacom

# Registro privado da Wacom
@wacom:registry=https://npm.wacom.com/node-modules/

# Token de autenticação
# Substitua AUTH_TOKEN_HERE pelo token fornecido pela Wacom
# Você receberá o token em: https://developer.wacom.com
//npm.wacom.com/node-modules/:_authToken=AUTH_TOKEN_HERE

# Necessário para yarn
always-auth=true
