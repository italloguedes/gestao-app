    "CanvasHeight": 480
  },
  "Capture": {
    "DeviceIndex": 0,
    "CanvasWidth": 640,
    "CanvasHeight": 480,
    "FilterHoverPoints": true,
    "PollingIntervalMs": 10
  }
}
