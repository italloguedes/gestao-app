# Supabase Configuration
# Obtenha essas credenciais em: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Admin)
# IMPORTANTE: Esta chave tem privilégios administrativos. NUNCA exponha no cliente!
# Use apenas em rotas API do servidor (app/api/*)
# Obtenha em: https://app.supabase.com/project/_/settings/api (seção "service_role key")
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cron Secret Key
# IMPORTANTE: Token secreto para proteger a rota /api/cron
# Gere um token seguro aleatório (ex: use `openssl rand -hex 32`)
# Use este token no header Authorization: Bearer <CRON_SECRET> ao chamar a rota
CRON_SECRET=your_secure_random_token_here

# Email Configuration (Gmail/SMTP)
# Para Gmail: Crie uma senha de aplicativo em https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_app_password

# Email Configuration (Alternative SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# Environment
NODE_ENV=development
